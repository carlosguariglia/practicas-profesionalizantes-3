#!/usr/bin/env node
// Simple runner (ESM): use `node run test` to execute tests/test_suite.mjs
import { spawn } from 'child_process';
import path from 'path';
import { fileURLToPath } from 'url';
import { createRequire } from 'module';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const cmd = process.argv[2];

async function serverIsUp(baseUrl) {
    try {
        const res = await fetch(baseUrl, { method: 'GET' });
        if (res && (res.status === 200 || res.status === 404 || res.status === 405)) return true;
    } catch (e) {
        // ignore
    }

    try {
        const u = new URL(baseUrl);
        const host = u.hostname;
        const port = Number(u.port) || 80;
        const require = createRequire(import.meta.url);
        const net = require('net');
        await new Promise(function(resolve, reject) {
            const sock = net.createConnection({ host: host, port: port }, function() {
                sock.destroy();
                resolve(true);
            });
            sock.setTimeout(1000, function() {
                sock.destroy();
                reject(new Error('timeout'));
            });
            sock.on('error', function(err) {
                sock.destroy();
                reject(err);
            });
        });
        return true;
    } catch (e) {
        return false;
    }
}

async function main() {
    if (!cmd) {
        console.error('Usage: node run <command>');
        process.exit(1);
    }

    if (cmd !== 'test') {
        console.error('Unknown command:', cmd);
        process.exit(1);
    }

    let script = path.join(__dirname, 'tests', 'test_suite.mjs');
    try {
        const fs = await import('fs');
        if (!fs.existsSync(script)) script = path.join(__dirname, 'tests', 'run_tests.mjs');
    } catch (e) {
        script = path.join(__dirname, 'tests', 'run_tests.mjs');
    }

    const BASE = process.env.BASE || 'http://localhost:3000';
    let serverChild = null;
    const alreadyUp = await serverIsUp(BASE + '/');

    if (!alreadyUp) {
        const serverScript = path.join(__dirname, 'main.mjs');
        console.log('Starting server via', serverScript);
        serverChild = spawn(process.execPath, [serverScript], { stdio: 'inherit', env: process.env });
        serverChild.on('error', function(err) {
            if (err && err.code === 'EADDRINUSE') {
                console.log('Port already in use; assuming server already running.');
                serverChild = null;
            } else {
                console.error('Server process error:', err);
            }
        });

        const start = Date.now();
        const timeout = 15000;
        let ready = false;
        while (Date.now() - start < timeout) {
            await new Promise(function(resolve) { setTimeout(resolve, 200); });
            if (await serverIsUp(BASE + '/')) { ready = true; break; }
            if (await serverIsUp(BASE.replace('127.0.0.1', 'localhost') + '/')) { ready = true; break; }
            if (await serverIsUp(BASE.replace('localhost', '127.0.0.1') + '/')) { ready = true; break; }
        }

        if (!ready) {
            console.error('Server did not start within timeout. Killing server process.');
            if (serverChild && serverChild.pid) {
                try { process.kill(serverChild.pid); } catch (e) {}
            }
            process.exit(1);
        }
    } else {
        console.log('Server already running at', BASE);
    }

    const testChild = spawn(process.execPath, [script], { stdio: 'inherit', env: process.env });
    testChild.on('exit', function(code) {
        if (serverChild && serverChild.pid) {
            try { process.kill(serverChild.pid); } catch (e) {}
        }
        process.exit(code);
    });
}

main().catch(function(err) {
    console.error(err);
    process.exit(1);
});
